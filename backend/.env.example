NODE_ENV=development
PORT=5000

# MongoDB (Prisma requires a replica set — see README)
DATABASE_URL="mongodb://127.0.0.1:27018/texan_website_checker?replicaSet=rs0&directConnection=true"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-32+-char-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Comma separated list of allowed frontend origins
CLIENT_URL="http://localhost:3000"

# Initial admin (used by `npm run seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Texan Admin"

# SMTP (optional — emails are logged as SKIPPED when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Texan Website Checker <no-reply@example.com>"

# Scanner
SCAN_USER_AGENT="TexanWebsiteChecker/1.0 (+https://example.com/bot)"
SCAN_MAX_CONCURRENCY=3

# Optional comma-separated DNS servers for Email & DNS checks (default: OS resolver)
# DNS_SERVERS=1.1.1.1,8.8.8.8
